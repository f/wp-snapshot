{
  "name": "wp-snapshot",
  "version": "0.1.2",
  "description": "Export a public WordPress site as deployable, offline-safe static HTML.",
  "type": "module",
  "bin": {
    "wp-snapshot": "bin/wp-snapshot.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test --test-reporter spec",
    "check": "node --check bin/wp-snapshot.js && node --check src/*.js && npm test",
    "pack:check": "publint && attw --pack . --profile esm-only",
    "verify": "npm run check && npm run pack:check",
    "prepublishOnly": "npm run check && publint"
  },
  "keywords": [
    "wordpress",
    "static-site",
    "snapshot",
    "crawler",
    "export",
    "offline"
  ],
  "author": "Fatih",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f/wp-snapshot.git"
  },
  "bugs": {
    "url": "https://github.com/f/wp-snapshot/issues"
  },
  "homepage": "https://github.com/f/wp-snapshot#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "es-module-lexer": "^2.3.2",
    "ipaddr.js": "^2.5.0",
    "postcss": "^8.5.26",
    "postcss-value-parser": "^4.2.0",
    "robots-parser": "^3.0.1",
    "srcset": "^5.0.3",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.24"
  }
}
